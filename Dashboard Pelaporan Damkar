// URL Web App Google Apps Script. Setelah Code.gs dideploy,
// ganti nilai ini dengan URL berakhiran /exec.
const API_URL = 'https://script.google.com/macros/s/AKfycbykkERPNDDcZjB-cEeeTHsJJ47WGbxkqz6gI05WvPwgpeZmjTMp1RImrMcTV0yJAqGpAg/exec';
const DATABASE_SPREADSHEET_ID = '1hT9prF1FJ9nSU2sCV4tEnoNQ-shcTKuUUL8Zq1VG7AE';
const DATABASE_SHEET_GID = '834153259';



