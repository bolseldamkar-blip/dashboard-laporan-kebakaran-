function processKPIs(data) {

const total = data.length;

const kebakaranCount = data.filter(d =>
d.jenis.toLowerCase().includes('kebakaran') ||
d.jenis.toLowerCase().includes('fire')).length;

const rescueCount = data.filter(d => d.jenis.toLowerCase().includes('evakuasi')
|| d.jenis.toLowerCase().includes('rescue') ||
d.jenis.toLowerCase().includes('penyelamatan') ||
d.jenis.toLowerCase().includes('pohon')).length;



// Mengambil jumlah status Selesai

const selesaiCount = data.filter(d => {

const s = (d.status || '').toLowerCase();

return s.includes('selesai') || s.includes('tuntas') || s.includes('teratasi')
|| s.includes('done');

}).length;

const belumSelesaiCount = total - selesaiCount;



// Compute Average Response Time in Minutes and Overtime Count (>15 Min)

let totalResponseMinutes = 0;

let validResponseCount = 0;

let overtimeCount = 0;

data.forEach(d => {

const numMatch = String(d.responseTime || '').match(/\d+/);

if (numMatch) {

const mins = parseInt(numMatch[0]);

totalResponseMinutes += mins;

validResponseCount++;

if (mins > 15) overtimeCount++;

}

});

const avgResponse = validResponseCount > 0 ? (totalResponseMinutes /
validResponseCount).toFixed(1) : 0;



document.getElementById('kpi-total').innerText = total;

document.getElementById('kpi-kebakaran').innerText = kebakaranCount;

document.getElementById('kpi-rescue').innerText = rescueCount;

document.getElementById('kpi-selesai').innerText = selesaiCount;

document.getElementById('kpi-response-time').innerText = `${avgResponse} Min`;



const kebPct = total > 0 ? Math.round((kebakaranCount / total) * 100) : 0;



document.getElementById('kpi-kebakaran-pct').innerText = `${kebPct}% dari total
laporan`;

document.getElementById('kpi-selesai-pct').innerHTML = `<span
class="text-emerald-400 font-semibold">${selesaiCount}
Selesai</span> &bull; <span class="text-slate-400
font-medium">${belumSelesaiCount} Belum Selesai</span>`;



const responseStatusEl = document.getElementById('kpi-response-status');

const responseSubtextEl = document.getElementById('kpi-response-subtext');



if (parseFloat(avgResponse) <= 15) {

responseStatusEl.className = 'flex items-center gap-1 text-[11px] text-emerald-400 font-semibold';

responseStatusEl.innerHTML = `<i class="fa-solid
fa-circle-check"></i> Sesuai Target SPM (≤15 Min)`;

} else {

responseStatusEl.className = 'flex items-center gap-1 text-[11px] text-red-400 font-bold animate-pulse';

responseStatusEl.innerHTML = `<i class="fa-solid
fa-triangle-exclamation"></i> Tidak Sesuai Target SPM (>15
Min)`;

}



if (responseSubtextEl) {

responseSubtextEl.innerHTML = overtimeCount > 0 

? `<span class="text-red-400 font-semibold">${overtimeCount}
laporan</span> melebihi standar 15 min`

: `Semua laporan memenuhi standar ≤15 min`;

}

}



function applyFilters() {

const selectedCat = document.getElementById('filter-category').value;

const selectedStatus = document.getElementById('filter-status').value;

const selectedDate = document.getElementById('filter-date').value;

const searchKeyword =
document.getElementById('filter-search').value.toLowerCase().trim();



const now = new Date();



filteredData = rawData.filter(item => {

// Category Filter

if (selectedCat !== 'ALL' && item.jenis !== selectedCat) {

return false;

}



// Status Filter (Strict Selesai / Belum Selesai)

if (selectedStatus !== 'ALL') {

if (item.status !== selectedStatus) {

return false;

}

}



// Date Filter

if (selectedDate !== 'ALL' && item.timestamp) {

const itemDate = new Date(item.timestamp.replace(' ', 'T'));

if (!isNaN(itemDate.getTime())) {

const diffTime = Math.abs(now - itemDate);

const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));



if (selectedDate === 'TODAY' && itemDate.toDateString() !==
now.toDateString()) {

return false;

} else if (selectedDate === 'WEEK' && diffDays > 7) {

return false;

} else if (selectedDate === 'MONTH' && (itemDate.getMonth() !==
now.getMonth() || itemDate.getFullYear() !== now.getFullYear())) {

return false;

}

}

}



// Search Filter

if (searchKeyword !== '') {

const matchPelapor = item.pelapor.toLowerCase().includes(searchKeyword);

const matchLokasi = item.lokasi.toLowerCase().includes(searchKeyword);

const matchKeterangan = item.keterangan.toLowerCase().includes(searchKeyword);

const matchJenis = item.jenis.toLowerCase().includes(searchKeyword);

const matchStatus = item.status.toLowerCase().includes(searchKeyword);



if (!matchPelapor && !matchLokasi && !matchKeterangan
&& !matchJenis && !matchStatus) {

return false;

}

}



return true;

});



processKPIs(filteredData);

updateCharts(filteredData);

currentPage = 1;

renderTable();

}



function resetFilters() {

document.getElementById('filter-category').value = 'ALL';

document.getElementById('filter-status').value = 'ALL';

document.getElementById('filter-date').value = 'ALL';

document.getElementById('filter-search').value = '';

applyFilters();

}



function sortTable(column) {

if (sortColumn === column) {

sortAsc = !sortAsc;

} else {

