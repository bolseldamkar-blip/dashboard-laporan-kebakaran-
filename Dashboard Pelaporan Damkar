}



function updateCharts(data) {

// 1. Category Chart (Doughnut)

const categoryCounts = {};

data.forEach(d => {

const cat = d.jenis || 'Lain-lain';

categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;

});



const catLabels = Object.keys(categoryCounts);

const catData = Object.values(categoryCounts);



if (categoryChartInstance) {

categoryChartInstance.destroy();

}



const ctxCat = document.getElementById('categoryChart').getContext('2d');

categoryChartInstance = new Chart(ctxCat, {

type: 'doughnut',

data: {

labels: catLabels,

datasets: [{

data: catData,

backgroundColor: [

'#ef4444', '#f97316', '#f59e0b', '#06b6d4', '#3b82f6', '#8b5cf6', '#ec4899',
'#10b981'

],

borderWidth: 2,

borderColor: '#0f172a'

}]

},

options: {

responsive: true,

maintainAspectRatio: false,

plugins: {

legend: {

position: 'bottom',

labels: { color: '#94a3b8', font: { size: 11, family: 'Plus Jakarta Sans' } }

}

}

}

});



// 2. Trend Chart (Line)

const dateCounts = {};

data.forEach(d => {

let dateStr = 'Unknown';

if (d.timestamp) {

dateStr = d.timestamp.split(' ')[0] || d.timestamp.split('T')[0] ||
d.timestamp;

}

dateCounts[dateStr] = (dateCounts[dateStr] || 0) + 1;

});



const sortedDates = Object.keys(dateCounts).sort();

const trendData = sortedDates.map(date => dateCounts[date]);



if (trendChartInstance) {

trendChartInstance.destroy();

}



const ctxTrend = document.getElementById('trendChart').getContext('2d');

trendChartInstance = new Chart(ctxTrend, {

type: 'line',

data: {

labels: sortedDates,

datasets: [{

label: 'Jumlah Laporan',

data: trendData,

borderColor: '#ef4444',

backgroundColor: 'rgba(239, 68, 68, 0.15)',

fill: true,

tension: 0.3,

pointBackgroundColor: '#f87171',

pointRadius: 4

}]

},

options: {

responsive: true,

maintainAspectRatio: false,

scales: {

x: {

ticks: { color: '#94a3b8', font: { size: 10 } },

grid: { color: 'rgba(255, 255, 255, 0.05)' }

},

y: {

beginAtZero: true,

ticks: { color: '#94a3b8', precision: 0 },

grid: { color: 'rgba(255, 255, 255, 0.05)' }

}

},

plugins: {

legend: { display: false }

}

}

});

}



function renderTable() {

const tbody = document.getElementById('tableBody');

tbody.innerHTML = '';



if (filteredData.length === 0) {

tbody.innerHTML = `<tr><td colspan="8"
class="text-center py-8 text-slate-500">Tidak ada data laporan
yang sesuai filter.</td></tr>`;

document.getElementById('row-count').innerText = `Menampilkan 0 data`;

document.getElementById('page-indicator').innerText = `Hal 0 dari 0`;

document.getElementById('btn-prev').disabled = true;

document.getElementById('btn-next').disabled = true;

return;

}



// Sort data

filteredData.sort((a, b) => {

let valA = a[sortColumn] || '';

let valB = b[sortColumn] || '';

if (sortAsc) return valA.localeCompare(valB);

return valB.localeCompare(valA);

});



// Pagination slice

const totalPages = Math.ceil(filteredData.length / pageSize);

const startIndex = (currentPage - 1) * pageSize;

const pageData = filteredData.slice(startIndex, startIndex + pageSize);



pageData.forEach((row) => {

const tr = document.createElement('tr');

tr.className = 'hover:bg-slate-800/50 transition-colors border-b border-slate-800/60';



const sLower = (row.status || '').toLowerCase();

const isSelesai = sLower.includes('selesai') || sLower.includes('tuntas') ||
sLower.includes('teratasi') || sLower.includes('done');

const statusBadge = isSelesai

? `<span class="bg-emerald-500/15 text-emerald-400 border
border-emerald-500/30 px-2.5 py-1 rounded-full text-[10px] font-bold
inline-flex items-center gap-1 justify-center"><i
class="fa-solid fa-circle-check"></i> ${escapeHtml(row.status)}</span>`

: `<span class="bg-amber-500/15 text-amber-400 border
border-amber-500/30 px-2.5 py-1 rounded-full text-[10px] font-bold inline-flex
items-center gap-1 justify-center"><i class="fa-solid
fa-hourglass-half"></i> ${escapeHtml(row.status)}</span>`;



// Calculate Response Time status for Table Badge (15 Min SPM Threshold)

const numMatch = String(row.responseTime || '').match(/\d+/);

const respMins = numMatch ? parseInt(numMatch[0]) : 0;

const isOvertime = respMins > 15;

const responseBadge = isOvertime

? `<span class="bg-red-500/20 text-red-400 border border-red-500/40
px-2 py-1 rounded-lg font-mono font-bold text-[11px] inline-flex items-center
gap-1.5 shadow-sm" title="Tidak Sesuai Standar SPM (>15
Menit)"><i class="fa-solid fa-triangle-exclamation
text-red-400"></i> ${escapeHtml(row.responseTime)} <span
class="text-[9px] uppercase font-extrabold bg-red-600 text-white px-1.5
py-0.5 rounded tracking-wide">Tidak Sesuai (&gt;15m)</span></span>`

: `<span class="bg-cyan-500/10 text-cyan-400 border border-cyan-500/30
px-2.5 py-1 rounded-lg font-mono font-bold text-[11px] inline-flex items-center
gap-1"><i class="fa-solid fa-stopwatch
text-cyan-400"></i> ${escapeHtml(row.responseTime)} <span
class="text-[9px] uppercase font-semibold bg-emerald-500/20
text-emerald-400 border border-emerald-500/30 px-1 rounded">Sesuai
(≤15m)</span></span>`;



tr.innerHTML = `

<td class="py-3 px-5 font-mono text-slate-400
whitespace-nowrap">${escapeHtml(row.timestamp)}</td>

<td class="py-3 px-5 font-semibold
text-white">${escapeHtml(row.pelapor)}</td>

<td class="py-3 px-5"><span class="bg-red-500/10
text-red-400 px-2.5 py-1 rounded-lg text-[11px] font-medium border
border-red-500/20">${escapeHtml(row.jenis)}</span></td>

<td class="py-3 px-5">${responseBadge}</td>

<td class="py-3 px-5 text-slate-300 max-w-xs truncate"
title="${escapeHtml(row.lokasi)}">${escapeHtml(row.lokasi)}</td>

<td class="py-3 px-5 text-slate-400 max-w-xs truncate"
title="${escapeHtml(row.keterangan)}">${escapeHtml(row.keterangan)}</td>

<td class="py-3 px-5 text-center">${statusBadge}</td>

<td class="py-3 px-5 text-center">

<button onclick="openDetailModal(${row.id})"
class="bg-slate-800 hover:bg-slate-700 text-sky-400 border
border-slate-700 px-2.5 py-1 rounded-lg transition-all text-[11px] font-medium
cursor-pointer">

<i class="fa-solid fa-eye"></i> Detail

</button>

</td>

`;

tbody.appendChild(tr);

});



document.getElementById('row-count').innerText = `Menampilkan ${startIndex +
1}-${Math.min(startIndex + pageSize, filteredData.length)} dari
${filteredData.length} data`;

document.getElementById('page-indicator').innerText = `Hal ${currentPage} dari
${totalPages}`;

document.getElementById('btn-prev').disabled = currentPage === 1;

document.getElementById('btn-next').disabled = currentPage === totalPages ||
totalPages === 0;

}



function nextPage() {

const totalPages = Math.ceil(filteredData.length / pageSize);

if (currentPage < totalPages) {

currentPage++;

renderTable();

}

}



function prevPage() {

if (currentPage > 1) {

currentPage--;

renderTable();

}

}



function changePageSize() {

pageSize = parseInt(document.getElementById('page-size').value);

currentPage = 1;

renderTable();

}



function escapeHtml(text) {

if (!text) return '';

return String(text).replace(/&/g, "&amp;").replace(/</g,
"&lt;").replace(/>/g, "&gt;");

}



