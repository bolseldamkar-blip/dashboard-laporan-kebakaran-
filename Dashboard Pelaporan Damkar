document.getElementById('modal-time').innerText = item.timestamp;

document.getElementById('modal-pelapor').innerText = item.pelapor;

document.getElementById('modal-jenis').innerText = item.jenis;

document.getElementById('modal-response-time').innerText = item.responseTime;

document.getElementById('modal-lokasi').innerText = item.lokasi;

document.getElementById('modal-keterangan').innerText = item.keterangan;



const sLower = (item.status || '').toLowerCase();

const isSelesai = sLower.includes('selesai') || sLower.includes('tuntas') ||
sLower.includes('teratasi') || sLower.includes('done');

document.getElementById('modal-status').innerHTML = isSelesai

? `<span class="bg-emerald-500/20 text-emerald-400 border
border-emerald-500/30 px-3 py-1 rounded-full text-xs font-bold inline-flex
items-center gap-1.5"><i class="fa-solid
fa-circle-check"></i> ${escapeHtml(item.status)}</span>`

: `<span class="bg-amber-500/20 text-amber-400 border
border-amber-500/30 px-3 py-1 rounded-full text-xs font-bold inline-flex
items-center gap-1.5"><i class="fa-solid
fa-hourglass-half"></i> ${escapeHtml(item.status)}</span>`;



// Check SPM response time status (>15 Min trigger)

const numMatch = String(item.responseTime || '').match(/\d+/);

const respMinutes = numMatch ? parseInt(numMatch[0]) : 10;

const badgeEl = document.getElementById('modal-response-badge');

if (respMinutes <= 15) {

badgeEl.className = 'text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2.5 py-1 rounded-full font-bold inline-flex items-center gap-1';

badgeEl.innerHTML = '<i class="fa-solid fa-circle-check"></i> Sesuai Standar SPM (≤15 Min)';

} else {

badgeEl.className = 'text-[10px] bg-red-500/25 text-red-300 border border-red-500/50 px-2.5 py-1 rounded-full font-bold inline-flex items-center gap-1 animate-pulse';

badgeEl.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-red-400"></i> Tidak Sesuai Standar SPM (>15 Min)';

}



document.getElementById('modal-map-btn').href =
`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.lokasi)}`;



// Dynamically render all original columns from Google Sheets in the detail
modal

const rawContainer = document.getElementById('modal-raw-fields');

if (rawContainer && item.rawRow) {

rawContainer.innerHTML = '';

Object.keys(item.rawRow).forEach(key => {

const val = item.rawRow[key];

const fieldDiv = document.createElement('div');

fieldDiv.className = 'p-2 rounded-lg bg-slate-900/90 border border-slate-800 text-[11px]';

fieldDiv.innerHTML = `<span class="text-amber-300 font-semibold
block">${escapeHtml(key)}:</span> <span
class="text-slate-200">${escapeHtml(String(val ||
'-'))}</span>`;

rawContainer.appendChild(fieldDiv);

});

}



document.getElementById('detail-modal').classList.remove('hidden');

}



function closeDetailModal() {

document.getElementById('detail-modal').classList.add('hidden');

}



function changeAutoSyncInterval() {

const val = parseInt(document.getElementById('auto-sync-select').value);

if (autoSyncTimer) clearInterval(autoSyncTimer);



if (val > 0) {

autoSyncTimer = setInterval(fetchData, val);

document.getElementById('next-sync-label').innerText = `Auto-sync aktif
(${val/1000}s)`;

} else {

document.getElementById('next-sync-label').innerText = `Auto-sync
dinonaktifkan`;

}

}



function exportCSV() {

if (filteredData.length === 0) {

showNotification("Tidak ada data untuk diexport.", true);

return;

}



const csvData = Papa.unparse(filteredData.map(d => ({

"Timestamp": d.timestamp,

"Nama Pelapor": d.pelapor,

"Jenis Kejadian": d.jenis,

"Response Time": d.responseTime,

"Lokasi": d.lokasi,

"Keterangan": d.keterangan,

"Status": d.status

})));



const blob = new Blob([csvData], { type: 'text/csv;charset=utf-8;' });

const link = document.createElement("a");

const url = URL.createObjectURL(blob);

link.setAttribute("href", url);

link.setAttribute("download", `laporan_damkar_${new
Date().toISOString().substring(0,10)}.csv`);

document.body.appendChild(link);

link.click();

document.body.removeChild(link);

}



// Initialize Application

window.onload = function() {

fetchData();

changeAutoSyncInterval();

};

</script>

</body>

