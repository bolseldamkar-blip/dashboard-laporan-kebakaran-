async function fetchData() {
const statusEl=document.getElementById('connection-status');
const refreshIcon=document.getElementById('refresh-icon');
const loadingOverlay=document.getElementById('loading-overlay');
const dashboardContent=document.getElementById('dashboard-content');
if(refreshIcon) refreshIcon.classList.add('fa-spin');
statusEl.innerHTML=`<i class="fa-solid fa-circle-notch fa-spin text-amber-400"></i><span class="text-amber-400">Menghubungkan ke Database...</span>`;
if(rawData.length===0){loadingOverlay.style.display='flex';dashboardContent.classList.add('hidden');}
if(!API_URL||API_URL==='PASTE_APPS_SCRIPT_WEB_APP_URL_HERE'){
 if(refreshIcon) refreshIcon.classList.remove('fa-spin'); loadingOverlay.style.display='none'; dashboardContent.classList.remove('hidden');
 statusEl.innerHTML=`<i class="fa-solid fa-triangle-exclamation text-amber-400"></i><span class="text-amber-400 font-semibold">API belum dikonfigurasi</span>`;
 showNotification('Masukkan URL Web App Google Apps Script pada konstanta API_URL di index.html.',true);
 rawData=[]; populateCategoryDropdown(rawData); populateStatusDropdown(rawData); applyFilters(); return;
}
try{
 const response=await fetch(`${API_URL}?t=${Date.now()}`,{method:'GET',cache:'no-store',redirect:'follow'});
 if(!response.ok) throw new Error(`HTTP ${response.status} - ${response.statusText}`);
 const result=await response.json();
 if(!result.success) throw new Error(result.message||'API mengembalikan status gagal.');
 const rows=Array.isArray(result.data)?result.data:[];
 rawData=normalizeData(rows);
 statusEl.innerHTML=`<i class="fa-solid fa-circle-check text-emerald-400"></i><span class="text-emerald-400 font-semibold">Live Database Connected</span>`;
 showNotification(`Berhasil memuat ${Number(result.total??rows.length)} data laporan dari Google Spreadsheet.`);
 loadingOverlay.style.display='none'; dashboardContent.classList.remove('hidden');
 populateCategoryDropdown(rawData); populateStatusDropdown(rawData); applyFilters();
}catch(err){
 console.error('Database API error:',err); loadingOverlay.style.display='none'; dashboardContent.classList.remove('hidden');
 statusEl.innerHTML=`<i class="fa-solid fa-triangle-exclamation text-red-400"></i><span class="text-red-400 font-semibold">Database API gagal</span>`;
 showNotification(`Gagal mengambil data dari backend: ${err.message}`,true);
 populateCategoryDropdown(rawData); populateStatusDropdown(rawData); applyFilters();
}finally{if(refreshIcon) refreshIcon.classList.remove('fa-spin');}
}

function normalizeData(data) {
return data.map((row,index)=>{
 const keys=Object.keys(row);
 const findVal=(terms)=>{for(const term of terms){const key=keys.find(k=>k.toLowerCase().includes(term.toLowerCase()));if(key&&row[key]!==undefined&&row[key]!==null&&String(row[key]).trim()!=='')return String(row[key]).trim();}return '';};
 const timestamp=findVal(['timestamp','waktu','tanggal','time','date'])||'-';
 const pelapor=findVal(['nama pelapor','nama','pelapor','pengirim','pelapor/saksi','identitas'])||'Warga (Anonim)';
 const jenis=findVal(['jenis kejadian','jenis','kejadian','kategori','insiden','musibah','tipe'])||'Tidak diketahui';
 const responseTime=findVal(['response time','response','tanggap','waktu tanggap','durasi','kecepatan','respon'])||'-';
 const lokasi=findVal(['lokasi kejadian','lokasi','alamat','tempat','posisi','titik'])||'Wilayah Operasional Damkar';
 const keterangan=findVal(['deskripsi kejadian','deskripsi','kronologi','keterangan','detail','catatan','uraian','rincian','penjelasan','informasi'])||'Tidak ada deskripsi detail';
 const status=findVal(['hasil penanganan','hasil','status penanganan','status','penanganan','kondisi','progres','tindak lanjut'])||'Belum Ada Status';
 return {id:Number(row._row)||index+1,timestamp,pelapor,jenis,responseTime,lokasi,keterangan,status,rawRow:row};
}).filter(item => {
 // Dashboard hanya menampilkan laporan yang sudah selesai/dituntaskan.
 const s = String(item.status || '').toLowerCase();
 return s.includes('selesai') || s.includes('tuntas') || s.includes('teratasi') || s.includes('done');
});
}



function populateCategoryDropdown(data) {

